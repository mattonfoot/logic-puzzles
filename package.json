{
  "name": "deduction",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "eas:login": "npx eas-cli login",
    "build:ios": "npx eas-cli build --platform ios --profile preview",
    "build:ios:dev": "npx eas-cli build --platform ios --profile development",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "sounds": "node scripts/sounds.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.8",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2"
  },
  "jest": {
    "preset": "jest-expo/ios",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ]
  },
  "overrides": {
    "uuid": "^14.0.2"
  }
}
